# syntax=docker/dockerfile:1
# Build context: patternfly-doc-core repo root.
# --target org-audit-default uses the package already locked by patternfly-org.
# --target org-audit-npm installs doc-core from the npm registry.
# --target org-audit-local copies and builds this checkout before linking it.
FROM docker.io/library/node:22-bookworm AS org-audit-base

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /patternfly-org

ARG ORG_REPO=https://github.com/patternfly/patternfly-org.git
ARG ORG_REF=main
ARG DOC_CORE_GIT_SHA=

ENV DOC_CORE_GIT_SHA="${DOC_CORE_GIT_SHA}"

RUN git clone --depth 1 --branch "${ORG_REF}" "${ORG_REPO}" .

RUN corepack enable

COPY tests/container/utils/install-doc-core.sh /usr/local/bin/install-doc-core.sh
COPY tests/container/utils/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/install-doc-core.sh /usr/local/bin/entrypoint.sh

FROM org-audit-base AS org-audit-default

RUN yarn install --immutable
RUN DOC_CORE_SOURCE=default /usr/local/bin/install-doc-core.sh

ENV NODE_OPTIONS=--max-old-space-size=8192

RUN yarn ci:build:doc-core

ENV SITE_DIST=/patternfly-org/packages/site/dist
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM org-audit-base AS org-audit-npm

ARG DOC_CORE_NPM_SPEC=latest
RUN DOC_CORE_SOURCE=npm DOC_CORE_NPM_SPEC="${DOC_CORE_NPM_SPEC}" /usr/local/bin/install-doc-core.sh

ENV NODE_OPTIONS=--max-old-space-size=8192

RUN yarn ci:build:doc-core

ENV SITE_DIST=/patternfly-org/packages/site/dist
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

FROM docker.io/library/node:22-bookworm AS doc-core-local

WORKDIR /patternfly-doc-core
COPY . .

FROM org-audit-base AS org-audit-local

COPY --from=doc-core-local /patternfly-doc-core /patternfly-doc-core
RUN DOC_CORE_SOURCE=local /usr/local/bin/install-doc-core.sh

ENV NODE_OPTIONS=--max-old-space-size=8192

RUN yarn ci:build:doc-core

ENV SITE_DIST=/patternfly-org/packages/site/dist
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
